{
  "name": "devashish-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "build": "bun run build.ts",
    "preview:cloudflare": "bun run build && wrangler dev",
    "deploy": "bun run build && wrangler deploy",
    "deploy:dry-run": "bun run build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-slot": "^1.3.3",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.0.0",
    "geist": "^1.9.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.52.0",
    "mermaid": "^12.2.0",
    "react": "^19",
    "react-dom": "^19",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.7.0",
    "torph": "^0.1.3",
    "tunnel-rat": "^0.1.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4.1.11",
    "wrangler": "^4.0.0"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
